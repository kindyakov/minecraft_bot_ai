        <mxCell id="state-MONITORING-ENTITIES_MONITOR" parent="state-MONITORING" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;strokeWidth=2" value="&lt;div&gt;&lt;b&gt;ENTITIES_MONITOR&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Invokes entity tracking and keeps target / removal context up to date.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="200" x="1960" y="330" as="geometry" />
        </mxCell>
        <mxCell id="note-root-entry" parent="1" style="shape=note;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingTop=18;spacingLeft=12;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5" value="&lt;div&gt;&lt;b&gt;MINECRAFT_BOT&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px; white-space:pre-line;&quot;&gt;Parallel XState root. MAIN_ACTIVITY owns current behavior; MONITORING keeps health, hunger, and entities hot.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="45" width="900" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="note-external-triggers" parent="1" style="shape=note;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingTop=18;spacingLeft=12;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5" value="&lt;div&gt;&lt;b&gt;External triggers&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px; white-space:pre-line;&quot;&gt;USER_COMMAND -&amp;gt; TASKS.THINKING START_COMBAT -&amp;gt; COMBAT STOP_COMBAT -&amp;gt; THINKING or IDLE DEATH / STOP_CURRENT_GOAL -&amp;gt; IDLE START_URGENT_NEEDS -&amp;gt; EMERGENCY_EATING or EMERGENCY_HEALING&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="560" x="1785" y="545" as="geometry" />
        </mxCell>
        <mxCell id="note-agent-loop" parent="1" style="shape=note;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingTop=18;spacingLeft=12;fillColor=#ecfeff;strokeColor=#0f766e;strokeWidth=1.5" value="&lt;div&gt;&lt;b&gt;Agent loop&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px; white-space:pre-line;&quot;&gt;THINKING invokes one agent turn, EXECUTING runs exactly one pending tool, DECIDE_NEXT loops until finish or anti-loop abort.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="560" x="1785" y="745" as="geometry" />
        </mxCell>
        <mxCell id="note-mining" parent="1" style="shape=note;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingTop=18;spacingLeft=12;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=1.5" value="&lt;div&gt;&lt;b&gt;Mining workflow&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px; white-space:pre-line;&quot;&gt;mine_resource is the only deep execution subtree. It validates preconditions, searches blocks, navigates, breaks, retries, and records completion or failure.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="560" x="1785" y="895" as="geometry" />
        </mxCell>
        <mxCell id="note-combat-services" parent="1" style="shape=note;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingTop=18;spacingLeft=12;fillColor=#fff7ed;strokeColor=#c2410c;strokeWidth=1.5" value="&lt;div&gt;&lt;b&gt;Invoked actors&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px; white-space:pre-line;&quot;&gt;COMBAT: serviceApproaching, serviceMeleeAttack, serviceRangedSkirmish URGENT_NEEDS: emergencyEating / emergencyHealing MONITORING: serviceEntitiesTracking&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="560" x="1785" y="1065" as="geometry" />
        </mxCell>
        <mxCell id="note-legend" parent="1" style="shape=note;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingTop=18;spacingLeft=12;fillColor=#ffffff;strokeColor=#111827;strokeWidth=1.5" value="&lt;div&gt;&lt;b&gt;Legend&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px; white-space:pre-line;&quot;&gt;Solid arrows = normal transitions Animated arrows = hot loops worth watching Dashed arrows = cross-lane or external triggers State captions summarize purpose, not raw action lists&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="560" x="1785" y="1205" as="geometry" />
        </mxCell>
